# Copy to .env and fill in. .env is git-ignored.
# Which provider to use: ollama | openrouter | ollama,openrouter (default: ollama)
CHAT_PROVIDERS=ollama
OPENROUTER_API_KEY=
DB_URL=jdbc:postgresql://localhost:5432/llm-playground
DB_USER=
DB_PASSWORD=
# Optional, defaults to http://localhost:11434
OLLAMA_BASE_URL=
